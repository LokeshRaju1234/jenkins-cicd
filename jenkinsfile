pipeline {
    agent any

    stages
    {
        stage('Checkout')
        {
            steps{
                git branch: 'master',
                    credentialsId: 'github-creds',
                    url: 'https://github.com/LokeshRaju1234/jenkins-cicd.git'
            }
        }
        stage('Build')
        {
            steps
            {
                bat 'mvn clean compile'
            }
        }

        stage('Test')
        {
            steps{
                bat 'mvn test'
            }
        }

        stage('Package')
        {
            steps{
                bat 'mvn package'
            }
        }
    }

    post{
        always{
            echo 'Finished'
        }
    }
}